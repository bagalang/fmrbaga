// route.baga — HTTP router with {param} path patterns.
// Pure. Methods are matched case-sensitively (use uppercase at register time).

import "std/str/str.baga"

struct Router {
    methods: Vec<str>,
    patterns: Vec<str>,
    ids: Vec<i64>,
    // OpenAPI meta per route (parallel vecs). "" = unset; public -1 = unset.
    summaries: Vec<str>,
    tags: Vec<str>,
    publics: Vec<i64>,
    body_schemas: Vec<str>,
    ok_schemas: Vec<str>,
    codes: Vec<str>,
    queries: Vec<str>
}

fn router_new() -> Router {
    return Router {
        methods: vec_new(), patterns: vec_new(), ids: vec_new(),
        summaries: vec_new(), tags: vec_new(), publics: vec_new(),
        body_schemas: vec_new(), ok_schemas: vec_new(), codes: vec_new(), queries: vec_new()
    }
}

fn router_add(r: Router, method: str, pattern: str, id: i64) -> Router {
    return router_add_meta(r, method, pattern, id, "", "", -1, "", "", "", "")
}

// Route + OpenAPI metadata (see openapi/openapi.baga for field meanings):
//   summary  — operation summary ("" = generated "METHOD pattern")
//   tag      — OpenAPI tag ("" = derived from path)
//   public   — 1 = no Bearer; 0 = Bearer; -1 = heuristic
//   body     — request body schema name; "Name?" = optional
//   ok       — 200/2xx response schema name; "-" = empty body; "" = heuristic
//   code     — success status code as text ("" = heuristic)
//   query    — comma list of query params: "name" (int) / "name:s" (string)
fn router_add_meta(r: Router, method: str, pattern: str, id: i64,
        summary: str, tag: str, public: i64, body: str, ok: str, code: str, query: str) -> Router {
    vec_push(r.methods, method)
    vec_push(r.patterns, pattern)
    vec_push(r.ids, id)
    vec_push(r.summaries, summary)
    vec_push(r.tags, tag)
    vec_push(r.publics, public)
    vec_push(r.body_schemas, body)
    vec_push(r.ok_schemas, ok)
    vec_push(r.codes, code)
    vec_push(r.queries, query)
    return r
}

struct RouteMeta {
    summary: str,
    tag: str,
    public: i64,   // -1 = unset
    body: str,
    ok: str,
    code: str,
    query: str
}

fn router_meta(r: Router, i: i64) -> RouteMeta {
    return RouteMeta {
        summary: vec_get(r.summaries, i),
        tag: vec_get(r.tags, i),
        public: vec_get(r.publics, i),
        body: vec_get(r.body_schemas, i),
        ok: vec_get(r.ok_schemas, i),
        code: vec_get(r.codes, i),
        query: vec_get(r.queries, i)
    }
}

// Fail-loud startup check: registering the same METHOD + pattern twice is a
// bug (first match silently wins at dispatch time). "" = OK; else the first
// duplicate named.
fn router_validate(r: Router) -> str {
    for i in 0..vec_len(r.ids) {
        let mut j: i64 = i + 1
        while j < vec_len(r.ids) {
            if vec_get(r.methods, i) == vec_get(r.methods, j) {
                if vec_get(r.patterns, i) == vec_get(r.patterns, j) {
                    return concat(concat("duplicate route: ", vec_get(r.methods, i)),
                        concat(" ", vec_get(r.patterns, i)))
                }
            }
            j = j + 1
        }
    }
    return ""
}

// Split path into segments; empty leading segment from "/" is dropped.
fn route_segments(path: str) -> Vec<str> {
    let raw = str_split(path, "/")
    let out = vec_new()
    for i in 0..vec_len(raw) {
        let s = vec_get(raw, i)
        if s != "" {
            vec_push(out, s)
        }
    }
    return out
}

// True if segment is "{name}".
fn route_is_param(seg: str) -> i64 {
    if len(seg) >= 3 {
        if char_at(seg, 0) == 123 {
            if char_at(seg, len(seg) - 1) == 125 {
                return 1
            }
        }
    }
    return 0
}

fn route_param_name(seg: str) -> str {
    return substr(seg, 1, len(seg) - 1)
}

struct RouteMatch {
    ok: i64,
    id: i64,
    pnames: Vec<str>,
    pvals: Vec<str>
}

fn route_match_one(method: str, path: str, m: str, pattern: str, id: i64) -> RouteMatch {
    let empty_n = vec_new()
    let empty_v = vec_new()
    if method != m {
        return RouteMatch { ok: 0, id: 0, pnames: empty_n, pvals: empty_v }
    }
    let ps = route_segments(path)
    let pats = route_segments(pattern)
    if vec_len(ps) != vec_len(pats) {
        return RouteMatch { ok: 0, id: 0, pnames: empty_n, pvals: empty_v }
    }
    let names = vec_new()
    let vals = vec_new()
    for i in 0..vec_len(pats) {
        let pat = vec_get(pats, i)
        let got = vec_get(ps, i)
        if route_is_param(pat) == 1 {
            vec_push(names, route_param_name(pat))
            vec_push(vals, got)
        } else {
            if pat != got {
                return RouteMatch { ok: 0, id: 0, pnames: empty_n, pvals: empty_v }
            }
        }
    }
    return RouteMatch { ok: 1, id: id, pnames: names, pvals: vals }
}

// First matching route wins (register specific routes before wildcards).
fn router_match(r: Router, method: str, path: str) -> RouteMatch {
    let empty_n = vec_new()
    let empty_v = vec_new()
    for i in 0..vec_len(r.ids) {
        let m = route_match_one(method, path, vec_get(r.methods, i), vec_get(r.patterns, i), vec_get(r.ids, i))
        if m.ok == 1 {
            return m
        }
    }
    return RouteMatch { ok: 0, id: 0, pnames: empty_n, pvals: empty_v }
}

// Method not allowed? true if path matches some pattern with different method.
fn router_path_exists(r: Router, path: str) -> i64 {
    let ps = route_segments(path)
    for i in 0..vec_len(r.ids) {
        let pats = route_segments(vec_get(r.patterns, i))
        if vec_len(ps) == vec_len(pats) {
            let mut ok: i64 = 1
            let mut j: i64 = 0
            while j < vec_len(pats) && ok == 1 {
                let pat = vec_get(pats, j)
                let got = vec_get(ps, j)
                if route_is_param(pat) == 0 {
                    if pat != got {
                        ok = 0
                    }
                }
                j = j + 1
            }
            if ok == 1 {
                return 1
            }
        }
    }
    return 0
}
