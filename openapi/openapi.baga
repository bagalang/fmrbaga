// openapi_schema.baga — schema builders (типове/компоненти/операции).
// openapi.baga — извличане на OpenAPI doc от Router: op_id/summary/params/
// body/ok schema от route-овете + per-route metadata, paths, catalog router,
// tags, финален doc. Роут метаданните (router_add_meta) са източникът за
// body/ok schema и security; heuristic fallback покрива само scaffold-а.

import "openapi_schema.baga"
import "../json/jsonx.baga"
import "../core/route.baga"

fn oas_op_id_for(method: str, pattern: str) -> str {
    let mut out = oas_lower_method(method)
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        out = concat(out, "_")
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            out = concat(out, route_param_name(s))
        } else {
            out = concat(out, s)
        }
    }
    if out == oas_lower_method(method) {
        out = concat(out, "_root")
    }
    return out
}

fn oas_summary_for(method: str, pattern: str) -> str {
    return concat(concat(method, " "), pattern)
}

// One query-param object from meta spec: "name" (int64) or "name:s" (string).
fn oas_query_param_obj(qspec: str) -> JObj {
    let s = str_trim(qspec)
    if s == "" {
        return jobj_new()
    }
    let mut name = s
    let mut schema = oas_int_schema()
    if len(s) >= 2 {
        if substr(s, len(s) - 2, len(s)) == ":s" {
            name = substr(s, 0, len(s) - 2)
            schema = oas_str_schema()
        }
    }
    let mut p = jobj_new()
    p = jobj_str(p, "name", name)
    p = jobj_str(p, "in", "query")
    p = jobj_bool(p, "required", 0)
    p = jobj_obj(p, "schema", schema)
    return p
}

// Path + query parameters for a route (query list comes from route meta).
fn oas_params_from_route(method: str, pattern: str, meta: RouteMeta) -> JArr {
    let mut params = jarr_new()
    let segs = route_segments(pattern)
    for i in 0..vec_len(segs) {
        let s = vec_get(segs, i)
        if route_is_param(s) == 1 {
            let name = route_param_name(s)
            let mut p = jobj_new()
            p = jobj_str(p, "name", name)
            p = jobj_str(p, "in", "path")
            p = jobj_bool(p, "required", 1)
            p = jobj_str(p, "description", concat(name, " path parameter"))
            if name == "id" {
                p = jobj_obj(p, "schema", oas_int_schema())
            } else {
                p = jobj_obj(p, "schema", oas_str_schema())
            }
            params = jarr_obj(params, p)
        }
    }
    let qs = str_split(meta.query, ",")
    for i in 0..vec_len(qs) {
        let po = oas_query_param_obj(vec_get(qs, i))
        if vec_len(po.keys) > 0 {
            params = jarr_obj(params, po)
        }
    }
    return params
}

// ---- Fallback heuristics (scaffold ops only — products carry their own
// metadata; no product paths hardcoded in the framework). ----

// Request body schema name; "" = none. "Name?" = optional body.
fn oas_body_schema(method: str, pattern: str) -> str {
    if method == "POST" {
        if pattern == "/v1/auth/token" {
            return "TokenRequest"
        }
    }
    return ""
}

// Primary success response schema; "" = empty body; heuristic default "Status".
fn oas_ok_schema(method: str, pattern: str) -> str {
    if method == "DELETE" {
        return ""
    }
    if pattern == "/health" {
        return "Status"
    }
    if pattern == "/ready" {
        return "Ready"
    }
    if pattern == "/openapi.json" {
        return ""
    }
    if pattern == "/metrics" {
        return ""
    }
    if pattern == "/v1/meta" {
        return "Status"
    }
    if pattern == "/v1/auth/token" {
        return "TokenResponse"
    }
    if pattern == "/v1/me" {
        return "Me"
    }
    return "Status"
}

fn oas_success_code(method: str, pattern: str) -> str {
    if method == "DELETE" {
        return "204"
    }
    return "200"
}

// Build one operation for a registered route (method + pattern + id + meta).
fn oas_op_from_route(method: str, pattern: str, id: i64, meta: RouteMeta) -> JObj {
    let mut tag = oas_tag_for(pattern)
    if meta.tag != "" {
        tag = meta.tag
    }
    let mut summary = oas_summary_for(method, pattern)
    if meta.summary != "" {
        summary = meta.summary
    }
    let mut op = oas_op(oas_op_id_for(method, pattern), summary, tag)
    op = jobj_i64(op, "x-baga-route-id", id)
    // Security: meta.public overrides the scaffold heuristic (-1 = unset).
    let mut public = oas_is_public(pattern, method)
    if meta.public != 0 - 1 {
        public = meta.public
    }
    if public == 0 {
        op = oas_add_bearer(op)
    }
    let params = oas_params_from_route(method, pattern, meta)
    if vec_len(params.items) > 0 {
        op = jobj_raw(op, "parameters", jarr_encode(params))
    }
    // Body: meta.body wins; "Name?" = optional request body.
    let mut body = oas_body_schema(method, pattern)
    if meta.body != "" {
        body = meta.body
    }
    if body != "" {
        let mut reqd: i64 = 1
        if len(body) >= 1 {
            if substr(body, len(body) - 1, len(body)) == "?" {
                body = substr(body, 0, len(body) - 1)
                reqd = 0
            }
        }
        op = oas_add_json_body(op, body, reqd)
    }
    let mut code = oas_success_code(method, pattern)
    if meta.code != "" {
        code = meta.code
    }
    // ok meta: "" = heuristic; "-" = explicitly empty body.
    let mut ok_schema = oas_ok_schema(method, pattern)
    if meta.ok != "" {
        if meta.ok == "-" {
            ok_schema = ""
        } else {
            ok_schema = meta.ok
        }
    }
    let mut resp = jobj_new()
    if ok_schema == "" {
        resp = jobj_obj(resp, code, oas_response_empty("OK"))
    } else {
        resp = jobj_obj(resp, code, oas_response_ref("OK", ok_schema))
    }
    if public == 0 {
        resp = jobj_obj(resp, "401", oas_response_ref("Unauthorized", "Error"))
    }
    if pattern == "/ready" {
        resp = jobj_obj(resp, "503", oas_response_ref("Unavailable", "Error"))
    }
    if body != "" {
        resp = jobj_obj(resp, "422", oas_response_ref("Validation Error", "HTTPValidationError"))
    }
    if method != "POST" {
        if str_find(pattern, "{id}") >= 0 {
            resp = jobj_obj(resp, "404", oas_response_ref("Not found", "Error"))
        }
    }
    op = jobj_obj(op, "responses", resp)
    return op
}

fn oas_pattern_seen(seen: Vec<str>, pattern: str) -> i64 {
    for i in 0..vec_len(seen) {
        if vec_get(seen, i) == pattern {
            return 1
        }
    }
    return 0
}

// Paths object: only routes present in `r` (source of truth = route table).
fn oas_paths_from_router(r: Router) -> JObj {
    let seen: Vec<str> = vec_new()
    for i in 0..vec_len(r.patterns) {
        let p = vec_get(r.patterns, i)
        if oas_pattern_seen(seen, p) == 0 {
            vec_push(seen, p)
        }
    }
    let mut paths = jobj_new()
    for si in 0..vec_len(seen) {
        let pattern = vec_get(seen, si)
        let mut item = jobj_new()
        for i in 0..vec_len(r.patterns) {
            if vec_get(r.patterns, i) == pattern {
                let method = vec_get(r.methods, i)
                let id = vec_get(r.ids, i)
                let op = oas_op_from_route(method, pattern, id, router_meta(r, i))
                item = jobj_obj(item, oas_lower_method(method), op)
            }
        }
        paths = jobj_obj(paths, pattern, item)
    }
    return paths
}

// Catalog router: same surface as apps/api (for pure unit tests without
// FmrApp). Metadata mirrors what the product registers via fmr_route_meta.
fn oas_catalog_router() -> Router {
    let mut r = router_new()
    r = router_add_meta(r, "GET", "/health", 1, "", "system", 1, "", "Status", "200", "")
    r = router_add_meta(r, "GET", "/ready", 2, "", "system", 1, "", "Ready", "200", "")
    r = router_add_meta(r, "GET", "/metrics", 5, "", "system", 0, "", "-", "200", "")
    r = router_add_meta(r, "GET", "/v1/meta", 3, "", "system", 1, "", "Status", "200", "")
    r = router_add_meta(r, "GET", "/openapi.json", 4, "", "system", 1, "", "-", "200", "")
    r = router_add_meta(r, "POST", "/v1/auth/token", 10, "", "auth", 1, "TokenRequest?", "TokenResponse", "200", "sub:s")
    r = router_add_meta(r, "GET", "/v1/me", 11, "", "auth", 0, "", "Me", "200", "")
    r = router_add_meta(r, "GET", "/v1/users", 20, "", "users", 0, "", "UserList", "200", "limit,offset")
    r = router_add_meta(r, "POST", "/v1/users", 21, "", "users", 0, "UserCreate", "User", "201", "")
    r = router_add_meta(r, "GET", "/v1/users/{id}", 22, "", "users", 0, "", "User", "200", "")
    r = router_add_meta(r, "PATCH", "/v1/users/{id}", 23, "", "users", 0, "UserPatch", "User", "200", "")
    r = router_add_meta(r, "DELETE", "/v1/users/{id}", 24, "", "users", 0, "", "-", "204", "")
    r = router_add_meta(r, "GET", "/v1/posts", 30, "", "posts", 0, "", "PostList", "200", "limit,offset,user_id")
    r = router_add_meta(r, "POST", "/v1/posts", 31, "", "posts", 0, "PostCreate", "Post", "201", "")
    r = router_add_meta(r, "GET", "/v1/posts/{id}", 32, "", "posts", 0, "", "Post", "200", "")
    r = router_add_meta(r, "PATCH", "/v1/posts/{id}", 33, "", "posts", 0, "PostCreate", "Post", "200", "")
    r = router_add_meta(r, "DELETE", "/v1/posts/{id}", 34, "", "posts", 0, "", "-", "204", "")
    return r
}

fn oas_tags() -> str {
    let mut tags = jarr_new()
    let mut t1 = jobj_new()
    t1 = jobj_str(t1, "name", "system")
    t1 = jobj_str(t1, "description", "Health and metadata")
    tags = jarr_obj(tags, t1)
    let mut t2 = jobj_new()
    t2 = jobj_str(t2, "name", "auth")
    t2 = jobj_str(t2, "description", "JWT issue and identity")
    tags = jarr_obj(tags, t2)
    let mut t3 = jobj_new()
    t3 = jobj_str(t3, "name", "users")
    t3 = jobj_str(t3, "description", "User CRUD (Bearer required)")
    tags = jarr_obj(tags, t3)
    let mut t4 = jobj_new()
    t4 = jobj_str(t4, "name", "posts")
    t4 = jobj_str(t4, "description", "Post CRUD (Bearer required)")
    tags = jarr_obj(tags, t4)
    return jarr_encode(tags)
}

// Full OpenAPI 3.0.3 from a live route table (B2.4).
fn fmr_openapi_from_router(r: Router, title: str, version: str) -> JObj {
    let mut info = jobj_new()
    info = jobj_str(info, "title", title)
    info = jobj_str(info, "version", version)
    info = jobj_str(info, "description", "fmrbaga API — paths emitted from the route table; JWT Bearer where required.")

    let mut root = jobj_new()
    root = jobj_str(root, "openapi", "3.0.3")
    root = jobj_obj(root, "info", info)
    root = jobj_raw(root, "tags", oas_tags())
    root = jobj_obj(root, "paths", oas_paths_from_router(r))
    root = jobj_obj(root, "components", oas_components())
    return root
}

// Pure helper for tests: catalog router (= apps/api surface).
fn fmr_openapi_doc(title: str, version: str) -> JObj {
    return fmr_openapi_from_router(oas_catalog_router(), title, version)
}
